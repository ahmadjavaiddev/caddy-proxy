cdn.tunly.cloud {
    tls /data/cert/cdn.tunly.cloud.pem /data/cert/cdn.tunly.cloud.key
    @ws {
        header Connection *Upgrade*
        header Upgrade websocket
    }
    reverse_proxy @ws 3x-ui:2096
    respond "OK" 200
}



